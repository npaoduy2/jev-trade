# Comma list of Hyperliquid perps.
HL_COINS=BTC,SOL,AAVE,PEPE
# true = testnet (default). Set false only for mainnet.
HL_TESTNET=true
# Decision + requote cadence. Jev picks leverage, open/close/hold, and long/short.
TICK_MS=60000
# Jev's answer budget per tick. Blank = half a tick, clamped to 4s..20s.
JEV_DEADLINE_MS=
# Chart and mid prints. Does not call Jev.
PRICE_MS=200
# Notional of one entry at 1x. Jev's leverage rung multiplies this, so 10x sends
# ten times the exposure on the same margin. Margin used stays QUOTE_USD per entry.
QUOTE_USD=40
# Ceiling on one entry's scaled notional. Sleeves on one wallet share a collateral
# pool and this caps each of them, so N coins can carry N times this.
MAX_NOTIONAL_USD=500
QUOTE_INSIDE_TICKS=1
# Worst price an exit will accept, past the far touch. A ceiling, not the price
# paid: the Ioc still fills at the best the book has. Too tight and a large exit
# fills in part and leaves the rest exposed until the next tick.
CLOSE_SLIPPAGE_BPS=25
BANKROLL_USD=200
# Tape and returns lookback, in ticks. At TICK_MS=60000 this is 100 minutes.
HORIZON_BLOCKS=100

# Live testnet: PRIVATE_KEY backs every coin in HL_COINS. One Hyperliquid account
# holds a position in every perp at once, and they share one collateral pool.
# To give a coin its own wallet instead, copy .wallets.example.json to
# .wallets.json (gitignored), or set
# WALLETS_JSON={"sleeves":[{"coin":"ETH","privateKey":"0x..."}]}
# Leave PRIVATE_KEY empty for a dry run: real book, real decisions, simulated fills.
# DRY_RUN=true forces simulated quotes even when keys are set.
PRIVATE_KEY=
DRY_RUN=false

# mock (default) | jev
MODEL=mock
# How Jev is called when MODEL=jev.
# typesafe = official TypeSafe API (https://docs.typesafe.ai/)
# gateway  = Vercel AI Gateway
# Unset: TypeSafe if TYPESAFE_API_KEY is set, else Gateway if AI_GATEWAY_API_KEY is set.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# Model id. Defaults: jev-latest (typesafe), typesafe-ai/jev (gateway)
JEV_MODEL_ID=jev-latest
# Gateway option. Set JEV_PROVIDER=gateway and fill this instead.
AI_GATEWAY_API_KEY=

# Bot SSE on 3000. Dashboard Next in web/ uses 3001.
PORT=3000
